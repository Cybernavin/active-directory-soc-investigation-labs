# Dashboard table: Top 5 Service Ticket Requests
index=AD-DC-01 host=DC01 EventCode=4769
| rex field=_raw "Data Name='TargetUserName'>(?<User>[^<]+)"
| rex field=_raw "Data Name='ServiceName'>(?<ServiceName>[^<]+)"
| rex field=_raw "Data Name='IpAddress'>(?<SourceIP>[^<]+)"
| where isnotnull(User) AND isnotnull(ServiceName)
| where NOT like(User,"%$$@CORP.LOCAL")
| where SourceIP!="::1" AND ServiceName!="krbtgt"
| where NOT like(ServiceName,"%$$")
| stats count dc(ServiceName) as UniqueServices values(ServiceName) as Services by SourceIP User
| sort - UniqueServices - count
| head 5
