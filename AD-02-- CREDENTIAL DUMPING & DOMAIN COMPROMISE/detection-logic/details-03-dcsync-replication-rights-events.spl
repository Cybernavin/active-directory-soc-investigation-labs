index=AD-DC-01 host=DC01 EventCode=4662
| rex field=_raw "Data Name='SubjectUserName'>(?<User>[^<]+)"
| rex field=_raw "Data Name='SubjectDomainName'>(?<Domain>[^<]+)"
| rex field=_raw "Data Name='ObjectName'>(?<ObjectName>[^<]+)"
| rex field=_raw "Data Name='Properties'>(?<Properties>[^<]+)"
| where match(Properties,"1131f6aa-9c07-11d1-f79f-00c04fc2dcd2")
    OR match(Properties,"1131f6ad-9c07-11d1-f79f-00c04fc2dcd2")
    OR match(Properties,"89e95b76-444d-4c62-991a-0facbeda640c")
| where User!="DC01$"
| eval Risk="CRITICAL"
| table _time User Domain ObjectName Properties Risk
| sort - _time
