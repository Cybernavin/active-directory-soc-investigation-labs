index=main host=SOC-LAB-1 EventCode=4648
| rex field=_raw "Subject:\s+Security ID:.*?\s+Account Name:\s+(?<SubjectUser>[^\r\n]+)\s+Account Domain:\s+(?<SubjectDomain>[^\r\n]+)"
| rex field=_raw "Account Whose Credentials Were Used:\s+Account Name:\s+(?<CredentialUser>[^\r\n]+)\s+Account Domain:\s+(?<CredentialDomain>[^\r\n]+)"
| rex field=_raw "Target Server:\s+Target Server Name:\s+(?<TargetServer>[^\r\n]+)"
| rex field=_raw "Process Information:\s+Process ID:\s+[^\r\n]+\s+Process Name:\s+(?<ProcessName>[^\r\n]+)"
| rex field=_raw "Network Information:\s+Network Address:\s+(?<SourceIP>[^\r\n]+)"
| table _time SubjectUser SubjectDomain CredentialUser CredentialDomain TargetServer ProcessName SourceIP
| sort - _time